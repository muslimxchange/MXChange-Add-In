<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>ec01ca60-6b41-4cfa-826f-9edd736be5f3</Id>
  <Version>1.3.3.0</Version>
  <ProviderName>Muslim Xchange</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="MXChange"/>
  <Description DefaultValue="Shariah compliance, purification and zakat data for stocks and ETFs, as Excel formulas: MX.TICKER, MX.ISIN and MX.FIELDS."/>
  <IconUrl DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://muslimxchange.com/contact/"/>
  <AppDomains>
    <AppDomain>https://muslimxchange.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="CustomFunctionsRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Functions.Script.Url"/>
            </Script>
            <Page>
              <SourceLocation resid="Functions.Page.Url"/>
            </Page>
            <Metadata>
              <SourceLocation resid="Functions.Metadata.Url"/>
            </Metadata>
            <Namespace resid="Functions.Namespace"/>
          </ExtensionPoint>
        </AllFormFactors>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Functions.Script.Url" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/functions.js"/>
        <bt:Url id="Functions.Metadata.Url" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/functions.json"/>
        <bt:Url id="Functions.Page.Url" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/functions.html"/>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://muslimxchange.com/excel-addin/"/>
        <bt:Url id="Commands.Url" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://muslimxchange.github.io/MXChange-Add-In/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Functions.Namespace" DefaultValue="MX"/>
        <bt:String id="GetStarted.Title" DefaultValue="MXChange is ready"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Muslim Xchange"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="MXChange"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open the MXChange pane from the Home tab, sign in with your username and an application password, then type =MX.TICKER(&quot;AAPL&quot;) in any cell."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Sign in and see the available fields and formulas"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>